# Copy to .env.local and fill in your Supabase publishable (anon) key.
# Dashboard: Project Settings → API → publishable key (starts with sb_publishable_ or eyJ...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: HTTP Basic Auth for the whole site. Remove to make the site public.
SITE_PASSWORD=your-password
