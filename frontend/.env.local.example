# Copy to .env.local and fill in your Supabase publishable (anon) key.
# Dashboard: Project Settings → API → publishable key (starts with sb_publishable_ or eyJ...)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Canonical site URL for sitemap, robots, and metadata (no trailing slash).
# Example: https://checkmyfood.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site password gate. Use a password string to require login.
# Set to off (or false) to make the site public. Unset defaults to a local gate.
SITE_PASSWORD=your-password
